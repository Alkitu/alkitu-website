# === apps/web — variables de entorno (PLANTILLA, sin secretos) ===
# Copia este archivo a `.env.local` y rellena los valores reales.
# `.env.local` está en .gitignore y NO se versiona nunca.

# --- MongoDB Atlas (auth + analítica propia) ---
# Auth.js (login OTP) y la analítica propia (sessions/page_views) viven aquí.
MONGODB_URI=mongodb+srv://<user>:<pass>@<cluster>/?retryWrites=true&w=majority
AUTH_SECRET=                                              # `openssl rand -base64 32` — firma sesiones y salt de analítica

# --- Resend (email transaccional / contacto + código de acceso) ---
RESEND_API_KEY=re_xxx                                     # SECRETO server-side
RESEND_FROM="[Concepto] <hola@tuconcepto.com>"           # remitente (requiere dominio verificado en Resend)
RESEND_TO=leoperez108@gmail.com                           # destino de los mensajes del formulario

# --- Microsoft Clarity (heatmaps + grabaciones, opcional) ---
NEXT_PUBLIC_CLARITY_ID=                                   # id del proyecto en clarity.microsoft.com; vacío = desactivado

# --- Vercel Blob (almacenamiento de imágenes, si aplica) ---
BLOB_READ_WRITE_TOKEN=                                    # Vercel → Storage → Blob → crear store → token R/W. Sin él, la subida de fotos falla

# --- Supabase (configurado, NO usado por auth/analítica; reservado) ---
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxx          # clave PÚBLICA (cliente) — ok exponer
SUPABASE_SERVICE_ROLE_KEY=                                # SECRETO server-side (admin) — pendiente
